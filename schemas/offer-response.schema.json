{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offer response",
  "description": "Model candidate only; business validation is required before presentation or execution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["reply", "offer_id"],
  "properties": {
    "reply": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "offer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    }
  }
}
